# demo runs locally without a key. Set gemini to enable real AI generation.
AI_PROVIDER=demo
GEMINI_API_KEY=
# Configurable: choose a model available to your Google AI Studio project.
GEMINI_MODEL=gemini-3.5-flash
BACKEND_URL=http://127.0.0.1:8000
# Optional local API token. The frontend sends it in X-API-Key.
BACKEND_API_KEY=
REQUEST_TIMEOUT_SECONDS=90
RATE_LIMIT_PER_MINUTE=30
